generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     String @default("USER")
  requests Request[]
  bookings Booking[]
  notifications Notification[]
  reviews  Review[]
}

model Itinerary {
  id          String   @id @default(uuid())
  userId      String
  sourceType  String   // "AI" | "ADMIN"
  city        String
  days        Int
  budget      String
  groupSize   Int
  contentJson String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  requests Request[]
  bookings    Booking[]
}

model Request {
  id          String   @id @default(uuid())
  userId      String
  itineraryId String
  status      RequestStatus
  revisionMessage String?
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])
  revisionStatus  String?
  finalPrice Int?
  messages RequestMessage[]
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  itineraryId   String? 
  tourId   String?
  tour     Tour? @relation(fields: [tourId], references: [id])
  requestId     String?
  advanceAmount Int @default(0)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id])
  itinerary   Itinerary? @relation(fields: [itineraryId], references: [id])
  paymentStatus String @default("PENDING")
  paymentId     String?
  orderId       String?
  travelDate DateTime?
  timeSlot   String?
  travelers  Int @default(1)
}

model Tour {
  id            String   @id @default(uuid())
  title         String
  description   String
  price         Int
  imageUrl      String?
  gallery       String[]
  highlights    String[]
  inclusions    String[]
  exclusions    String[]
  duration      String?
  pickupPoint   String?
  pickupTime      String?
  availabilityNote String?
  createdAt     DateTime @default(now())
  bookings      Booking[]
  reviews       Review[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  userId    String
  user      User @relation(fields: [userId], references: [id])
  tourId    String
  tour      Tour @relation(fields: [tourId], references: [id])
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
}

model RequestMessage {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id])
  senderType String
  message    String
  createdAt  DateTime @default(now())
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  REVISION_SENT
  APPROVED
  REJECTED
}